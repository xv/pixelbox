<Window x:Class="PixelBox.Demo.Windows.LoupeControlDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelBox.Demo"
        xmlns:PixelBox="clr-namespace:PixelBox;assembly=PixelBox"
        mc:Ignorable="d"
        Title="Loupe Control Demo"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        AllowsTransparency="False"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border>
            <PixelBox:Loupe
                x:Name="Magnifier"
                PixelSize="13"
                GridSize="23"
                RefreshInterval="15"/>
        </Border>

        <Border Grid.Row="1"
            Padding="10,10,10,10"
            BorderBrush="#121212"
            BorderThickness="0,1,0,0"
            Background="#191919">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle
                    x:Name="ColorPreviewBox"
                    Width="{Binding Height, ElementName=ColorPreviewBox}"
                    Height="20"
                    Margin="0,0,10,0"
                    Fill="Transparent"
                    Stroke="#121212"
                    StrokeThickness="1"/>

                <TextBlock
                    x:Name="ColorTextBlock"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Text="#??????"
                    Foreground="#A9A9A9"/>

                <TextBlock
                    x:Name="PositionTextBlock"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Text="[?,?]"
                    Foreground="#6A6A6A"/>
            </Grid>
        </Border>
    </Grid>
</Window>