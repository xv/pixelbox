<Window x:Class="PixelBox.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelBox.Demo"
        xmlns:converter="clr-namespace:PixelBox.Demo.BindingConverters"
        xmlns:PixelBox="clr-namespace:PixelBox;assembly=PixelBox"
        mc:Ignorable="d"
        Title="PixelBox Demo"
        Background="#242424"
        WindowStartupLocation="CenterScreen"
        MinWidth="320"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight">
    
    <Window.Resources>
        <converter:RectangleConverter x:Key="RectangleConverter"/>

        <Geometry x:Key="CopyIconGeometry">
            M20,4V16a2,2,0,0,1-2,2H10a2,2,0,0,1-2-2V4a2,2,0,0,1,2-2h8A2,2,0,0,1,20,4ZM16,21a1,1,0,0,0-1-1H6V6A1,1,0,0,0,4,6V20a2,2,0,0,0,2,2h9A1,1,0,0,0,16,21Z
        </Geometry>

        <Geometry x:Key="CheckIconGeometry">
            M9,16.17L4.83,12 3.41,13.41 9,19 21,7 19.59,5.59z
        </Geometry>

        <Style x:Key="KbdStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,2,4,2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#04599f"/>
            <Setter Property="BorderBrush" Value="#03518f"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#575757"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#747474"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect
            x:Key="RectDropShadowEffect"
            BlurRadius="4"
            Opacity=".2"
            ShadowDepth="2"
            Direction="270"
            Color="Black"/>

        <DropShadowEffect
            x:Key="KbdDropShadowEffect"
            BlurRadius="1"
            Opacity=".5"
            ShadowDepth="2"
            Direction="270"
            Color="#035292"/>
    </Window.Resources>

    <Grid
        Margin="15"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            x:Name="HintBar"
            Grid.Row="0"
            Background="#0568b5">
            <Border.Clip>
                <RectangleGeometry RadiusX="3" RadiusY="3">
                    <RectangleGeometry.Rect>
                        <MultiBinding Converter="{StaticResource RectangleConverter}">
                            <Binding Path="ActualWidth" ElementName="HintBar"/>
                            <Binding Path="ActualHeight" ElementName="HintBar"/>
                        </MultiBinding>
                    </RectangleGeometry.Rect>
                </RectangleGeometry>
            </Border.Clip>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon container -->
                <Rectangle
                    Width="35"
                    Height="Auto"
                    Fill="#035292"/>

                <!-- Icon -->
                <Viewbox x:Name="HintBarIcon" Width="18" Height="18">
                    <Canvas
                        Width="{Binding Width, ElementName=HintBarIcon}"
                        Height="{Binding Height, ElementName=HintBarIcon}">
                        <Path
                            Fill="White"
                            Stretch="Uniform"
                            Width="{Binding Width, ElementName=HintBarIcon}"
                            Height="{Binding Height, ElementName=HintBarIcon}"
                            Data="M256 71c8.284 0 15-6.716 15-15V15c0-8.284-6.716-15-15-15s-15 6.716-15 15v41c0 8.284 6.716 15 15 15zM426.606 53.394c-5.857-5.858-15.355-5.858-21.213 0l-32 32c-5.858 5.857-5.858 15.355 0 21.213s15.355 5.858 21.213 0l32-32c5.858-5.858 5.858-15.356 0-21.213zM138.606 106.606c5.858-5.857 5.858-15.355 0-21.213l-32-32c-5.857-5.858-15.355-5.858-21.213 0-5.858 5.857-5.858 15.355 0 21.213l32 32c5.859 5.859 15.356 5.858 21.213 0zM256 105c-83.262 0-151 67.738-151 151 0 77.192 72 114.978 72 160h64v-75.469c-18.58-6.276-32-23.86-32-44.531 0-8.284 6.716-15 15-15s15 6.716 15 15c0 9.374 7.626 17 17 17s17-7.626 17-17c0-8.284 6.716-15 15-15s15 6.716 15 15c0 20.671-13.42 38.255-32 44.531V416h64c0-45.037 72-82.776 72-160 0-83.262-67.738-151-151-151zM177 465c0 25.916 21.084 47 47 47h64c25.916 0 47-21.084 47-47v-19H177z">
                        </Path>
                    </Canvas>
                </Viewbox>

                <TextBlock
                    Grid.Column="1"
                    Margin="8"
                    MaxWidth="250"
                    Foreground="white"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap">
                    <Run Text="Press"/>
                    <InlineUIContainer
                        BaselineAlignment="Center"
                        Cursor="Hand">
                        <Border
                            Style="{StaticResource KbdStyle}"
                            MouseLeftButtonUp="Kbd_MouseLeftButtonUp"
                            Effect="{StaticResource KbdDropShadowEffect}">
                            <TextBlock Text="Space" FontSize="11" Foreground="White"/>
                        </Border>
                    </InlineUIContainer>
                    <Run Text="to show the magnifier window."/>
                </TextBlock>
            </Grid>
        </Border>

        <Border
            x:Name="PixelInfoPanel"
            Grid.Row="1"
            Background="#2e2e2e"
            BorderBrush="#414141"
            BorderThickness="1"
            Margin="0,10,0,0"
            Padding="13,12,13,10"
            CornerRadius="3"
            d:Visibility="Visible"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Rectangle
                    x:Name="ColorPreviewBox"
                    Width="{Binding Height, ElementName=ColorPreviewBox}"
                    Height="20"
                    Margin="0,0,10,0"
                    Fill="Transparent"
                    Stroke="White"
                    StrokeThickness="1"
                    RadiusX="2"
                    RadiusY="2"
                    Effect="{StaticResource RectDropShadowEffect}"/>

                <TextBox
                    x:Name="ColorTextBlock"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="#" 
                    Foreground="White"/>

                <TextBox 
                    x:Name="PositionTextBlock"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="X: ? Y: ?"
                    Foreground="White"/>

                <Button
                    x:Name="CopyColorTextButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Width="16"
                    Height="16"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="Copy Hex"
                    Click="CopyColorTextButton_Click">
                    <Viewbox>
                        <Path
                            x:Name="CopyIcon"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="{StaticResource CopyIconGeometry}"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>