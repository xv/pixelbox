<Window x:Class="PixelBox.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelBox.Demo"
        xmlns:converter="clr-namespace:PixelBox.Demo.BindingConverters"
        xmlns:PixelBox="clr-namespace:PixelBox;assembly=PixelBox"
        mc:Ignorable="d"
        Title="PixelBox Demo"
        Background="#242424"
        WindowStartupLocation="CenterScreen"
        MinWidth="320"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight">
    
    <Window.Resources>
        <converter:RectangleConverter x:Key="RectangleConverter"/>

        <Style x:Key="KbdStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,2,4,2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#04599f"/>
            <Setter Property="BorderBrush" Value="#03518f"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#575757"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#747474"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect
            x:Key="RectDropShadowEffect"
            BlurRadius="4"
            Opacity=".2"
            ShadowDepth="2"
            Direction="270"
            Color="Black"/>

        <DropShadowEffect
            x:Key="KbdDropShadowEffect"
            BlurRadius="1"
            Opacity=".5"
            ShadowDepth="2"
            Direction="270"
            Color="#035292"/>
    </Window.Resources>

    <Grid
        Margin="15"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            x:Name="HintBar"
            Grid.Row="0"
            Background="#0568b5">
            <Border.Clip>
                <RectangleGeometry RadiusX="3" RadiusY="3">
                    <RectangleGeometry.Rect>
                        <MultiBinding Converter="{StaticResource RectangleConverter}">
                            <Binding Path="ActualWidth" ElementName="HintBar"/>
                            <Binding Path="ActualHeight" ElementName="HintBar"/>
                        </MultiBinding>
                    </RectangleGeometry.Rect>
                </RectangleGeometry>
            </Border.Clip>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon container -->
                <Rectangle
                    Width="35"
                    Height="Auto"
                    Fill="#035292"/>

                <!-- Icon -->
                <Viewbox x:Name="HintBarIcon" Width="18" Height="18">
                    <Canvas
                        Width="{Binding Width, ElementName=HintBarIcon}"
                        Height="{Binding Height, ElementName=HintBarIcon}">
                        <Path
                            Fill="White"
                            Stretch="Uniform"
                            Width="{Binding Width, ElementName=HintBarIcon}"
                            Height="{Binding Height, ElementName=HintBarIcon}"
                            Data="{x:Static local:IconGeometries.Bulb}">
                        </Path>
                    </Canvas>
                </Viewbox>

                <TextBlock
                    Grid.Column="1"
                    Margin="8"
                    MaxWidth="250"
                    Foreground="white"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap">
                    <Run Text="Press"/>
                    <InlineUIContainer
                        BaselineAlignment="Center"
                        Cursor="Hand">
                        <Border
                            Style="{StaticResource KbdStyle}"
                            MouseLeftButtonUp="Kbd_MouseLeftButtonUp"
                            Effect="{StaticResource KbdDropShadowEffect}">
                            <TextBlock Text="Space" FontSize="11" Foreground="White"/>
                        </Border>
                    </InlineUIContainer>
                    <Run Text="to show the magnifier window."/>
                </TextBlock>
            </Grid>
        </Border>

        <Border
            x:Name="PixelInfoPanel"
            Grid.Row="1"
            Background="#2e2e2e"
            BorderBrush="#414141"
            BorderThickness="1"
            Margin="0,10,0,0"
            Padding="13,12,13,10"
            CornerRadius="3"
            d:Visibility="Visible"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Rectangle
                    x:Name="ColorPreviewBox"
                    Width="{Binding Height, ElementName=ColorPreviewBox}"
                    Height="20"
                    Margin="0,0,10,0"
                    Fill="Transparent"
                    Stroke="White"
                    StrokeThickness="1"
                    RadiusX="2"
                    RadiusY="2"
                    Effect="{StaticResource RectDropShadowEffect}"/>

                <TextBox
                    x:Name="ColorTextBlock"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="#" 
                    Foreground="White"/>

                <TextBox 
                    x:Name="PositionTextBlock"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="X: ? Y: ?"
                    Foreground="White"/>

                <Button
                    x:Name="CopyColorTextButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Width="16"
                    Height="16"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="Copy Hex"
                    Click="CopyColorTextButton_Click">
                    <Viewbox>
                        <Path
                            x:Name="CopyIcon"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="{x:Static local:IconGeometries.Copy}"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>